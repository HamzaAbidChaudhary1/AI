# --- shared by api + worker ---
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never shipped to the browser
SUPABASE_JWT_SECRET=                  # only needed for legacy HS256 projects; JWKS is used otherwise
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_DEEP=claude-opus-5-5
LLM_MODE=auto                         # auto | anthropic | offline
FIRECRAWL_API_KEY=
APIFY_TOKEN=
CRAWL_PROVIDER=auto                   # auto | live | fixture
FLIGHT_PROVIDER=sandbox               # sandbox | duffel | partner (Phase 6)
HOTEL_PROVIDER=sandbox
PAYMENT_PROVIDER=manual               # manual | safepay | payfast ... (Phase 6)
DOCS_ENCRYPTION_KEY=k1:<base64 32 bytes>   # rotate: "k2:<new>,k1:<old>"
RESEND_API_KEY=
SENTRY_DSN=
# --- api only ---
CORS_ORIGINS=https://<your-vercel-domain>
API_PUBLIC_URL=https://<api-domain>
REQUIRE_STAFF_MFA=true
CHECKPOINTER=postgres
# --- never in staging/prod ---
ALLOW_TEST_DATA=false
DEV_AUTH=false
